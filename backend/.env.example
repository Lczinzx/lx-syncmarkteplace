PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lxsync?schema=public"

# OBRIGATÓRIO: Chave secreta para assinar JWT de sessão (gere uma string aleatória segura)
JWT_SECRET="GERE_UMA_CHAVE_ALEATORIA_SEGURA_AQUI"

# OBRIGATÓRIO: Chave de criptografia AES-256 (32 bytes hexadecimal)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# OBRIGATÓRIO: E-mails autorizados como administradores (separados por vírgula)
ADMIN_EMAILS="lucasoliveiradossantos008@gmail.com,festumcontato@gmail.com"

# OBRIGATÓRIO: Google OAuth Client ID (mesmo valor usado no frontend como VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID="SEU_CLIENT_ID.apps.googleusercontent.com"

# OPCIONAL: Google Client Secret (só necessário se o fluxo exigir troca de authorization code)
# GOOGLE_CLIENT_SECRET="SEU_CLIENT_SECRET"

# OBRIGATÓRIO: URL do frontend para CORS
FRONTEND_URL="https://lxsync.netlify.app"

# OPCIONAL: habilita o seed DEMO idempotente da conta Festum Decor (Shopee) no PostgreSQL
# Somente TRUE em ambientes que precisam da conta de demonstração
ENABLE_DEMO_SEED=true
